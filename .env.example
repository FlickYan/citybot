# ---- Telegram ----
# Get from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# ---- football-data.org (fixtures, results, standings, squad) ----
# Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# ---- API-Football (per-player match stats, lineups) ----
# Direct:  https://dashboard.api-football.com  -> API_FOOTBALL_HOST=v3.football.api-sports.io
# RapidAPI: https://rapidapi.com/api-sports/api/api-football
#           -> API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# ---- Tracked club ----
TEAM_NAME=Manchester City
FOOTBALL_DATA_TEAM_ID=65
API_FOOTBALL_TEAM_ID=50

# ---- Behaviour ----
DEFAULT_TIMEZONE=Europe/London
# Minutes before kickoff to send reminders (comma separated)
DEFAULT_LEAD_TIMES=1440,60,15
# How often to refresh the fixture list, in minutes
FIXTURE_REFRESH_MINUTES=180
# How often to check for finished matches needing a summary, in minutes
RESULT_POLL_MINUTES=10
# Weekly digest: 0=Mon .. 6=Sun, and local hour
WEEKLY_DIGEST_DOW=0
WEEKLY_DIGEST_HOUR=9
DB_PATH=data/mancity.sqlite3
LOG_LEVEL=INFO
